{
  "name": "Daily Ledger",
  "short_name": "Ledger",
  "description": "Nightly tracker for money, sleep, mood, habits, time and to-dos.",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0C1210",
  "theme_color": "#006A4E",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log tonight", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stats", "url": "./#stats", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "To-do", "url": "./#todo", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
