{
  "id": "./",
  "name": "Life Log",
  "short_name": "Life Log",
  "description": "Seven days of hour-by-hour notes and spending.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0F1115",
  "theme_color": "#2B3DB0",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log this hour", "url": "./#hour", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Spent money", "url": "./#spend", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
